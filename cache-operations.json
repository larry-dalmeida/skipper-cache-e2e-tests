{
  "uid": "cache-performance-local",
  "title": "Cache Operations",
  "description": "Cache metrics from Stack A: Prometheus scrape of Skipper. Logs and traces are in Loki and Tempo datasources.",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "utc",
  "tags": [
    "skipper",
    "cache",
    "operations"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus datasource",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0,
        "multi": false,
        "includeAll": false,
        "options": []
      },
      {
        "name": "instance",
        "label": "Skipper instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up{job=\"skipper-local\"}, instance)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Client impact and scrape health",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "title": "Skipper scrape health",
      "description": "1 means the Skipper scrape succeeded.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No traffic / no data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"skipper-local\",instance=~\"${instance:regex}\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{result}} {{code_class}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "title": "Request rate by instance",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No traffic / no data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(skipper_serve_route_count{job=\"skipper-local\",instance=~\"${instance:regex}\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Responses by route and status",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No traffic / no data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route, code) (rate(skipper_serve_route_count{job=\"skipper-local\",instance=~\"${instance:regex}\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{route}} {{code}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Latency p95 by route",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No traffic / no data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (route, le) (rate(skipper_serve_route_duration_seconds_bucket{job=\"skipper-local\",instance=~\"${instance:regex}\"}[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{route}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Cache effectiveness",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 7,
      "title": "Fresh cache hit % (hit / hit + miss + stale)",
      "description": "Zero denominator or failed scrape yields no data, never 0%/100%.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "No traffic / no data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(100 * ((sum (rate(skipper_custom_total{job=\"skipper-local\",instance=~\"${instance:regex}\",key=~\"cache\\\\.(hit)\"}[$__rate_interval]))) or (0 * (sum (rate(skipper_custom_total{job=\"skipper-local\",instance=~\"${instance:regex}\",key=~\"cache\\\\.(hit|miss|stale)\"}[$__rate_interval]))))) / ((sum (rate(skipper_custom_total{job=\"skipper-local\",instance=~\"${instance:regex}\",key=~\"cache\\\\.(hit|miss|stale)\"}[$__rate_interval]))) > 0)) and on() (min(up{job=\"skipper-local\",instance=~\"${instance:regex}\"}) == 1)",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{result}} {{code_class}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "title": "Hit / miss / stale rate",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No traffic / no data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (key) (rate(skipper_custom_total{job=\"skipper-local\",instance=~\"${instance:regex}\",key=~\"cache\\\\.(hit|miss|stale)\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{key}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "title": "Cache result by status class",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No traffic / no data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result, code_class) (rate(skipper_cache_result_total{job=\"skipper-local\",instance=~\"${instance:regex}\",result=~\"hit|miss\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{result}} {{code_class}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 10,
      "title": "L1 / L2 hit rate",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No traffic / no data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result, code_class) (rate(skipper_cache_result_total{job=\"skipper-local\",instance=~\"${instance:regex}\",result=~\"l1_hit|l2_hit\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{result}} {{code_class}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 11,
      "type": "row",
      "title": "Refresh, saturation and resources",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 12,
      "title": "Refresh errors / dropped jobs",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "Not exercised / no samples",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (key) (rate(skipper_custom_total{job=\"skipper-local\",instance=~\"${instance:regex}\",key=~\"cache\\\\.(reval_error|reval_dropped)\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{key}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 13,
      "title": "Refresh job duration p95",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 35,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Not exercised / no samples",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(skipper_custom_duration_seconds_bucket{job=\"skipper-local\",instance=~\"${instance:regex}\",key=\"cache.reval_duration\"}[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{result}} {{code_class}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 14,
      "title": "Revalidation queue depth",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Not exercised / no samples",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(skipper_custom_gauges{job=\"skipper-local\",instance=~\"${instance:regex}\",key=\"cache.reval_queue_depth\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "queued jobs",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 15,
      "title": "Resident memory",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "No traffic / no data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (instance) (process_resident_memory_bytes{job=\"skipper-local\",instance=~\"${instance:regex}\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 16,
      "title": "CPU (cores)",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
