        "iconColor": "orange",
        "titleFormat": "{{origin}} availability change",
        "textFormat": "Controller change epoch {{value}}; run {{run_id}}",
        "tagKeys": "origin",
        "expr": "mock_origin_state_changed_seconds{job=\"mock-origin\"} and (changes(mock_origin_state_changed_seconds{job=\"mock-origin\"}[5s]) > 0)"
      }
    ]
