{
  "uid": "retail-application-local",
  "title": "Retail Application",
  "description": "Application-owner view of the synthetic retail workload on the LOCAL test stack. LOCAL synthetic test traffic only, combined across every LOCAL acceptance run in the selected window (not one acceptance run, not production). Every counter is rated per series before summing; current-value series are kept only while their own scrape target reports up == 1. Absent data means unknown or not exercised, never a healthy zero.",
  "tags": [
    "local-only",
    "synthetic",
    "combined-local-runs",
    "owned:contentful-acceptance-generic-v1"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "origin",
        "label": "Origin (cms / gateway)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "local-prometheus"
        },
        "definition": "label_values(mock_origin_requests_total{job=\"mock-origin\"}, origin)",
        "query": {
          "query": "label_values(mock_origin_requests_total{job=\"mock-origin\"}, origin)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "family",
        "label": "Retail family (Skipper route)",
        "type": "custom",
        "query": "contentful_footers_direct,contentful_footers_external,contentful_spaces,contentful_vouchers,shop_categories,shop_navigation,shop_products,shop_promotions,shop_search",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "locale",
        "label": "Locale (Skipper route)",
        "type": "custom",
        "query": "all,cs_CZ,da_DK,de_AT,de_CH,de_DE,de_LU,en_GB,es_ES,et_EE,fi_FI,fr_BE,fr_CH,fr_FR,fr_LU,hr_HR,hu_HU,it_IT,lt_LT,lv_LV,nl_BE,nl_NL,no_NO,pl_PL,ro_RO,sk_SK,sl_SI,sv_SE",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Origin availability changes (synthetic controller)",
        "enable": true,
        "hide": false,
