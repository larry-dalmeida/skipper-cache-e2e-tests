{
  "uid": "retail-application-local",
  "title": "Retail Application",
  "description": "Application-owner view of the synthetic retail workload on the LOCAL test stack. LOCAL synthetic test traffic only, combined across every LOCAL acceptance run in the selected window (not one acceptance run, not production). Every counter is rated per series before summing; current-value series are kept only while their own scrape target reports up == 1. Absent data means unknown or not exercised, never a healthy zero.",
  "tags": [
    "local-only",
    "synthetic",
    "combined-local-runs",
    "owned:contentful-acceptance-generic-v1"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "origin",
        "label": "Origin (cms / gateway)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "local-prometheus"
        },
        "definition": "label_values(mock_origin_requests_total{job=\"mock-origin\"}, origin)",
        "query": {
          "query": "label_values(mock_origin_requests_total{job=\"mock-origin\"}, origin)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "family",
        "label": "Retail family (origin completions)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "local-prometheus"
        },
        "definition": "label_values(mock_retail_requests_total{job=\"mock-origin\"}, family)",
        "query": {
          "query": "label_values(mock_retail_requests_total{job=\"mock-origin\"}, family)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "locale",
        "label": "Locale (origin completions)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "local-prometheus"
        },
        "definition": "label_values(mock_retail_requests_total{job=\"mock-origin\"}, locale)",
        "query": {
          "query": "label_values(mock_retail_requests_total{job=\"mock-origin\"}, locale)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Origin availability changes (synthetic controller)",
        "enable": true,
        "hide": false,
        "datasource": {
          "type": "prometheus",
          "uid": "local-prometheus"
