{
  "uid": "ag1x69aba3qpse",
  "title": "Skipper Cache Verification",
  "description": "Local synthetic traffic only. Check results/ for exact source SHAs. No nginx parity or production readiness claim.",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "utc",
  "tags": [
    "skipper",
    "cache",
    "local-verification"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus datasource",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0,
        "multi": false,
        "includeAll": false,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Skipper scrape health",
      "description": "1 means scrape succeeded, not that coalescing is correct.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"skipper-local\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{result}}{{key}}{{backend}} {{op}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "title": "Cache outcomes (cumulative since process start)",
      "description": "PR4364 alone still has the RequestURI bug: coalesce_error is expected. PR4365 fixes it but does not include PR4364's exporter additions.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "skipper_cache_result_total",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{result}}{{key}}{{backend}} {{op}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "L1 cache bytes by route",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "skipper_cache_lru_bytes",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{result}}{{key}}{{backend}} {{op}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Duration observations (cumulative)",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "skipper_custom_duration_seconds_count{key=~\"cache\\\\.(coalesce_wait|l2_get|l2_set)_duration\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{result}}{{key}}{{backend}} {{op}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Coalesce wait p95 (5 minute rate)",
      "description": "Exporter buckets and sums are seconds. Wait includes leader work; it is not a pure follower queue latency. No observations can yield NaN.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(skipper_custom_duration_seconds_bucket{key=\"cache.coalesce_wait_duration\"}[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{result}}{{key}}{{backend}} {{op}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "L2 get p95 (5 minute rate)",
      "description": "Exporter buckets and sums are seconds. Wait includes leader work; it is not a pure follower queue latency. No observations can yield NaN.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(skipper_custom_duration_seconds_bucket{key=\"cache.l2_get_duration\"}[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{result}}{{key}}{{backend}} {{op}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "title": "L2 set p95 (5 minute rate)",
      "description": "Exporter buckets and sums are seconds. Wait includes leader work; it is not a pure follower queue latency. No observations can yield NaN.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(skipper_custom_duration_seconds_bucket{key=\"cache.l2_set_duration\"}[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{result}}{{key}}{{backend}} {{op}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "title": "Storage faults (absent means NOT EXERCISED)",
      "description": "Do not interpret absent series as a tested zero. Fault injection is covered by targeted Go tests, not by disrupting shared Valkey.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (backend, op) (skipper_cache_storage_error_total)",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{result}}{{key}}{{backend}} {{op}}",
          "instant": false,
          "range": true
        }
      ]
    }
  ]
}
