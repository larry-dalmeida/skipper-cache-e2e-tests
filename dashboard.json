{
  "uid": "ag1x69aba3qpse",
  "title": "Skipper Cache Verification",
  "description": "Local synthetic traffic only. Check results/ for exact source SHAs. No nginx parity or production readiness claim.",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "utc",
  "tags": [
    "skipper",
    "cache",
    "local-verification"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus datasource",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0,
        "multi": false,
        "includeAll": false,
        "options": []
      },
      {
        "name": "instance",
        "label": "Skipper instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up{job=\"skipper-local\"}, instance)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Skipper scrape health",
      "description": "1 means scrape succeeded, not that coalescing is correct.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No traffic / no data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"skipper-local\",instance=~\"${instance:regex}\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{result}} {{code_class}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "title": "Fresh Cache Hit % (hit / hit + miss + stale)",
      "description": "Flat request-outcome counters include fallback misses missing from PR4364's labeled schema. Excludes errors and tier hits. Zero denominator or a failed scrape yields no data, never 0%/100%; missing hits are zero-filled only against a present positive request denominator.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "No traffic / no data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(100 * ((sum (rate(skipper_custom_total{job=\"skipper-local\",instance=~\"${instance:regex}\",key=~\"cache\\\\.(hit)\"}[$__rate_interval]))) or (0 * (sum (rate(skipper_custom_total{job=\"skipper-local\",instance=~\"${instance:regex}\",key=~\"cache\\\\.(hit|miss|stale)\"}[$__rate_interval]))))) / ((sum (rate(skipper_custom_total{job=\"skipper-local\",instance=~\"${instance:regex}\",key=~\"cache\\\\.(hit|miss|stale)\"}[$__rate_interval]))) > 0)) and on() (min(up{job=\"skipper-local\",instance=~\"${instance:regex}\"}) == 1)",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{result}} {{code_class}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Overall Cache Result by Status Code Class",
      "description": "Only overall hit/miss; excludes tier, stale and error counters. Missing miss series on PR4364 alone is an instrumentation gap, not zero.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No traffic / no data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result, code_class) (rate(skipper_cache_result_total{job=\"skipper-local\",instance=~\"${instance:regex}\",result=~\"hit|miss\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{result}} {{code_class}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "L1 Hits by Status Code Class",
      "description": "Tier diagnostics, not additional overall outcomes. Absent status classes are unexercised, not zero.",
