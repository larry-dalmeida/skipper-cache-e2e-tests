    {
      "id": 11,
      "title": "Coalesce wait p95 (adaptive rate window)",
      "description": "Exporter buckets and sums are seconds. Wait includes leader work; it is not a pure follower queue latency. No observations can yield NaN.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No traffic / no data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(skipper_custom_duration_seconds_bucket{job=\"skipper-local\",instance=~\"${instance:regex}\",key=\"cache.coalesce_wait_duration\"}[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{result}} {{code_class}}",
          "instant": false,
          "range": true
        }
