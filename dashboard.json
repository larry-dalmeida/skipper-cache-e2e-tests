{
  "uid": "ag1x69aba3qpse",
  "title": "Skipper Cache Verification",
  "description": "Local synthetic traffic only. Check results/ for exact source SHAs. No nginx parity or production readiness claim.",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "utc",
  "tags": [
    "skipper",
    "cache",
    "local-verification"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus datasource",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0,
        "multi": false,
        "includeAll": false,
        "options": []
      },
      {
        "name": "instance",
        "label": "Skipper instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up{job=\"skipper-local\"}, instance)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Skipper scrape health",
      "description": "1 means scrape succeeded, not that coalescing is correct.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"skipper-local\",instance=~\"${instance:regex}\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{result}} {{code_class}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "title": "Overall Cache Result by Status Code Class",
      "description": "Only overall hit/miss; excludes tier, stale and error counters. Missing miss series on PR4364 alone is an instrumentation gap, not zero.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result, code_class) (rate(skipper_cache_result_total{job=\"skipper-local\",instance=~\"${instance:regex}\",result=~\"hit|miss\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{result}} {{code_class}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "L1 Hits by Status Code Class",
      "description": "Tier diagnostics, not additional overall outcomes. Absent status classes are unexercised, not zero.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code_class) (rate(skipper_cache_result_total{job=\"skipper-local\",instance=~\"${instance:regex}\",result=\"l1_hit\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{code_class}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "L2 Hits by Status Code Class",
      "description": "Tier diagnostics, not additional overall outcomes. Absent status classes are unexercised, not zero.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code_class) (rate(skipper_cache_result_total{job=\"skipper-local\",instance=~\"${instance:regex}\",result=\"l2_hit\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{code_class}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Cache Hit vs Miss Rate (lines)",
      "description": "Identical 5-minute rates and scope. Normal stacking retains request volume, not percentages. Tier hits are excluded; absent misses are not fabricated.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(skipper_cache_result_total{job=\"skipper-local\",instance=~\"${instance:regex}\",result=~\"hit|miss\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{result}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Cache Hit vs Miss Rate (stacked)",
      "description": "Identical 5-minute rates and scope. Normal stacking retains request volume, not percentages. Tier hits are excluded; absent misses are not fabricated.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 40,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(skipper_cache_result_total{job=\"skipper-local\",instance=~\"${instance:regex}\",result=~\"hit|miss\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{result}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "title": "L1 cache bytes by route",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "skipper_cache_lru_bytes{job=\"skipper-local\",instance=~\"${instance:regex}\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{route}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "title": "Duration observations (cumulative)",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "skipper_custom_duration_seconds_count{job=\"skipper-local\",instance=~\"${instance:regex}\",key=~\"cache\\\\.(coalesce_wait|l2_get|l2_set)_duration\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{key}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "title": "Coalesce wait p95 (5 minute rate)",
      "description": "Exporter buckets and sums are seconds. Wait includes leader work; it is not a pure follower queue latency. No observations can yield NaN.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(skipper_custom_duration_seconds_bucket{job=\"skipper-local\",instance=~\"${instance:regex}\",key=\"cache.coalesce_wait_duration\"}[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{result}} {{code_class}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 10,
      "title": "L2 get p95 (5 minute rate)",
      "description": "Exporter buckets and sums are seconds. Wait includes leader work; it is not a pure follower queue latency. No observations can yield NaN.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(skipper_custom_duration_seconds_bucket{job=\"skipper-local\",instance=~\"${instance:regex}\",key=\"cache.l2_get_duration\"}[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{result}} {{code_class}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 11,
      "title": "L2 set p95 (5 minute rate)",
      "description": "Exporter buckets and sums are seconds. Wait includes leader work; it is not a pure follower queue latency. No observations can yield NaN.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(skipper_custom_duration_seconds_bucket{job=\"skipper-local\",instance=~\"${instance:regex}\",key=\"cache.l2_set_duration\"}[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{result}} {{code_class}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 12,
      "title": "Storage faults (absent means NOT EXERCISED)",
      "description": "Do not interpret absent series as a tested zero. Fault injection is covered by targeted Go tests, not by disrupting shared Valkey.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (backend, op) (skipper_cache_storage_error_total{job=\"skipper-local\",instance=~\"${instance:regex}\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{backend}} {{op}}",
          "instant": false,
          "range": true
        }
      ]
    }
  ]
}
